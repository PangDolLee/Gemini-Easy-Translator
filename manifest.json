{
  "manifest_version": 3,
  "name": "Gemini Easy Translator",
  "version": "1.5",
  "permissions": ["storage", "activeTab", "contextMenus", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>", "https://generativelanguage.googleapis.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["constants.js", "content.js"]
    }
  ]
}