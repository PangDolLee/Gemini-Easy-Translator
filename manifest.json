{
  "manifest_version": 3,
  "name": "Gemini Easy Translator",
  "version": "1.5",
  "permissions": ["storage", "activeTab", "contextMenus", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>", "https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["constants.js", "content.js"]
    }
  ]
}